<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.controller.features.bibliotecario.DetalheTituloController">

    <top>
        <fx:include source="components/TopBar.fxml" />
    </top>

    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <!-- Cabeçalho -->
            <VBox spacing="5">
                <Label fx:id="lblTitulo" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Titulo do Livro" />

                <Label fx:id="lblAutor" style="-fx-font-size: 16px;" text="Nome do autor" />

                <Label fx:id="lblIsbn" style="-fx-font-size: 14px;" text="ISBN: 123456" />
            </VBox>

            <!-- Linha separadora -->
            <Region style="-fx-background-color: #D9D9D9; -fx-min-height: 1;" />

            <!-- Estatísticas -->
            <HBox alignment="CENTER" spacing="40.0">

                <VBox spacing="5">
                    <Label text="Total de Exemplares" />
                    <Label fx:id="lblTotalExemplares" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="n° de exemplares" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Disponíveis" />
                    <Label fx:id="lblDisponiveis" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="n° de livors disponiveis" />
                </VBox>

                <VBox spacing="5" >
                    <Label text="Emprestados" />
                    <Label fx:id="lblEmprestados" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="n° de livros emprestados" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Reservas Pendentes" />
                    <Label fx:id="lblReservas" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="n° de reservas pendentes" />
                </VBox>

            </HBox>

            <!-- Linha separadora -->
            <Region style="-fx-background-color: #D9D9D9; -fx-min-height: 1;" />

            <!-- Tabela -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">

                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Exemplares" />

                <TableView fx:id="tbExemplares" onMouseClicked="#selecionarLivro" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colIdExemplar" prefWidth="-1.0" text="ID" />

                        <TableColumn fx:id="colStatus" prefWidth="-1.0" text="Status" />

                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>

                </TableView>

            </VBox>

            <!-- Botão Voltar -->
            <HBox alignment="CENTER_LEFT" onMouseClicked="#onVoltar" spacing="10.0">
                <children>
                    <Label fx:id="voltarBtn" onMouseClicked="#onVoltar" style="-fx-text-fill: #1A3783; -fx-font-weight: bold; -fx-font-size: 16px;" text="⬅ Voltar ao inventário">
                        <cursor><Cursor fx:constant="HAND" /></cursor>
                    </Label>
                </children>
                <cursor><Cursor fx:constant="HAND" /></cursor>
            </HBox>
            
        </VBox>
    </center>

</BorderPane>
