<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.controller.features.bibliotecario.InventarioController">
    <top>
        <fx:include source="components/TopBar.fxml" />
    </top>
    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" style="-fx-background-color: #E9EEF7; -fx-background: #E9EEF7;">
                <content>
                    <VBox spacing="20.0">
                        <padding><Insets bottom="120.0" left="40.0" right="40.0" top="30.0" /></padding>
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" text="Inventário de Títulos" />
                            <Label style="-fx-text-fill: #555555; -fx-font-size: 16px;" text="Visualize e gerencie todos os títulos da biblioteca." />
                        </VBox>

                        <FlowPane fx:id="containerLivros" alignment="TOP_LEFT" hgap="25.0" vgap="25.0" />
                    </VBox>
                </content>
            </ScrollPane>

            <StackPane alignment="BOTTOM_RIGHT" pickOnBounds="false">
                <StackPane maxHeight="75" maxWidth="75" onMouseClicked="#handleAdicionarLivro" style="-fx-cursor: hand;">
                    <StackPane.margin><Insets bottom="35.0" right="45.0" /></StackPane.margin>
                    <Circle fill="#1A3783" radius="35.0" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4);" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 40px; -fx-font-weight: bold;" text="+" />
                </StackPane>
            </StackPane>
        </StackPane>
    </center>

    <bottom>
        <fx:include source="components/BottomMenu.fxml"/>
    </bottom>
</BorderPane>
