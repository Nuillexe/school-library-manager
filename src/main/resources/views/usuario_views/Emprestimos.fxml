<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.controller.features.usuario.EmprestimosController">

    <top>
        <fx:include source="components/TopBar.fxml" />
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #E8EEF7;" styleClass="scroll-pane">
            <VBox spacing="18" style="-fx-padding: 30 200 30 200; -fx-background-color: #E8EEF7;">

                <VBox spacing="4">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" styleClass="section-title" text="Meus Empréstimos" />
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" styleClass="section-subtitle" text="Consulte seus empréstimos activos, prazos de devolução e histórico." />
                </VBox>

                <HBox fx:id="alertaBloqueado" alignment="TOP_LEFT" managed="false" spacing="12" styleClass="alert-card" visible="false">
                    <VBox alignment="CENTER" minWidth="32">
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #DC2626;" text="⚠" />
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #F59E0B;" text="⚠" />
                            <Label styleClass="alert-title" text="Acesso Bloqueado" />
                        </HBox>
                        <Label styleClass="alert-text" text="Você possui livros em atraso. Regularize suas devoluções para fazer novos empréstimos." wrapText="true" />
                    </VBox>
                </HBox>

                <VBox fx:id="listaEmprestimosContainer" spacing="12" />

                <VBox fx:id="emptyStateEmprestimos" alignment="CENTER" managed="false" spacing="16" styleClass="empty-card" visible="false">
                    <VBox alignment="CENTER" styleClass="empty-icon-circle">
                        <Label style="-fx-font-size: 26px;" text="📗" />
                    </VBox>
                    <Label styleClass="empty-title" text="Nenhum empréstimo ativo" />
                    <Label style="-fx-text-alignment: center;" styleClass="empty-subtitle" text="Você não possui livros emprestados no momento" wrapText="true" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <fx:include source="components/BottomMenu.fxml"/>
    </bottom>
</BorderPane>