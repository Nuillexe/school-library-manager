<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@css/biblioqueue.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.controller.features.usuario.EmprestimosController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #1E3A8A; -fx-padding: 16 24 16 24;" styleClass="top-bar">

            <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;" text="Bem Vindo" />
                <Label fx:id="lblNomeUsuario" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 16px;" text="Nome Aqui" />
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="20">
                <ImageView fitHeight="250.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../images/logo.png" />
                    </image>
                </ImageView>
                <Button onAction="#onLogout" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                    <graphic>
                        <ImageView fx:id="irParaLogin" fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../images/botaoSeta.jpeg" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #E8EEF7;" styleClass="scroll-pane">
            <VBox spacing="18" style="-fx-padding: 30 200 30 200; -fx-background-color: #E8EEF7;">

                <VBox spacing="4">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" styleClass="section-title" text="Meus Empréstimos" />
                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" styleClass="section-subtitle" text="Consulte seus empréstimos activos, prazos de devolução e histórico." />
                </VBox>

                <HBox fx:id="alertaBloqueado" alignment="TOP_LEFT" managed="false" spacing="12" styleClass="alert-card" visible="false">
                    <VBox alignment="CENTER" minWidth="32">
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #DC2626;" text="⚠" />
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #F59E0B;" text="⚠" />
                            <Label styleClass="alert-title" text="Acesso Bloqueado" />
                        </HBox>
                        <Label styleClass="alert-text" text="Você possui livros em atraso. Regularize suas devoluções para fazer novos empréstimos." wrapText="true" />
                    </VBox>
                </HBox>

                <VBox fx:id="listaEmprestimosContainer" spacing="12" />

                <VBox fx:id="emptyStateEmprestimos" alignment="CENTER" managed="false" spacing="16" styleClass="empty-card" visible="false">
                    <VBox alignment="CENTER" styleClass="empty-icon-circle">
                        <Label style="-fx-font-size: 26px;" text="📗" />
                    </VBox>
                    <Label styleClass="empty-title" text="Nenhum empréstimo ativo" />
                    <Label style="-fx-text-alignment: center;" styleClass="empty-subtitle" text="Você não possui livros emprestados no momento" wrapText="true" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0 transparent transparent transparent; -fx-border-width: 1 0 0 0; -fx-padding: 8 0 8 0;" styleClass="bottom-bar">
            <HBox alignment="CENTER" spacing="120" style="-fx-background-color: white; -fx-padding: 10 0 10 0; -fx-border-color: #E2E8F0 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                <children>
                    <VBox alignment="CENTER" onMouseClicked="#onNavCatalogo" prefWidth="426.0" spacing="5" style="-fx-cursor: hand;">
                        <children>
                            <ImageView fitHeight="51.0" fitWidth="470.0" preserveRatio="true">
                                <image>
                                    <Image url="@../../images/Catalogo.png" />
                                </image>
                            </ImageView>
                        </children>
                    </VBox>
                    <VBox alignment="CENTER" onMouseClicked="#onNavEmprestimos" prefWidth="426.0" spacing="5" style="-fx-cursor: hand;">
                        <children>
                            <ImageView fitHeight="63.0" fitWidth="71.0" preserveRatio="true">
                                <image>
                                    <Image url="@../../images/Emprestimo.png" />
                                </image>
                            </ImageView>
                        </children>
                    </VBox>
                    <VBox alignment="CENTER" onMouseClicked="#onNavReservas" prefWidth="426.0" spacing="5" style="-fx-cursor: hand;">
                        <children>
                            <ImageView fitHeight="58.0" fitWidth="59.0" preserveRatio="true">
                                <image>
                                    <Image url="@../../images/Reservas.png" />
                                </image>
                            </ImageView>
                        </children>
                    </VBox>
                </children>
            </HBox>
        </HBox>
    </bottom>

</BorderPane>