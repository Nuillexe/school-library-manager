<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #E8EEF7;" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.controller.features.usuario.DetalheLivroController">
    <top>
        <fx:include source="components/TopBar.fxml" />
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30 50 30 50;">

            <VBox spacing="5">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Detalhes do Livro" />
                <Label style="-fx-text-fill: #64748B; -fx-font-size: 14px;" text="Confira as informações da obra antes de prosseguir." />
            </VBox>

            <Button fx:id="btnVoltar" onAction="#onVoltar" style="-fx-background-color: transparent; -fx-text-fill: #1E3A8A; -fx-cursor: hand; -fx-font-weight: bold;" text="← Voltar ao catálogo" />

            <HBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">

                <VBox alignment="TOP_CENTER" prefWidth="500" spacing="20" style="-fx-padding: 40; -fx-border-color: #F1F5F9; -fx-border-width: 0 1 0 0;" HBox.hgrow="ALWAYS">

                    <VBox alignment="CENTER" maxHeight="120" maxWidth="120" minHeight="120" minWidth="120" style="-fx-background-color: #EFF6FF; -fx-background-radius: 20;">
                        <Label style="-fx-font-size: 60px;" text="📖" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="8">
                        <Label fx:id="lblTitulo" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Título do Livro" textAlignment="CENTER" wrapText="true" />
                        <Label fx:id="lblAutor" style="-fx-font-size: 16px; -fx-text-fill: #64748B;" text="Nome do Autor" />
                        <Label fx:id="lblAno" style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" text="2024" />
                        <Label fx:id="lblCategoria" style="-fx-background-color: #E0E7FF; -fx-text-fill: #4338CA; -fx-padding: 5 15; -fx-background-radius: 10; -fx-font-weight: bold;" text="Gênero" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #F8FAFC; -fx-padding: 15; -fx-background-radius: 10;">
                        <Label fx:id="lblEmprestimosAtivos" style="-fx-text-fill: #475569;" text="Empréstimos ativos: 0/0" />
                    </VBox>
                </VBox>

                <VBox prefWidth="500" spacing="25" style="-fx-padding: 40;" HBox.hgrow="ALWAYS">

                    <VBox spacing="15">
                        <HBox>
                            <Label prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="ISBN:" />
                            <Label fx:id="lblIsbn" style="-fx-text-fill: #1E293B;" text="000-0000000000" />
                        </HBox>
                        <HBox>
                            <Label prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Publicação:" />
                            <Label fx:id="lblDataPublicacao" style="-fx-text-fill: #1E293B;" text="Ano" />
                        </HBox>
                        <HBox>
                            <Label prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #64748B;" text="Disponibilidade:" />
                            <Label fx:id="lblDisponibilidade" style="-fx-font-weight: bold;" text="Status" />
                        </HBox>
                    </VBox>

                    <Separator />

                    <VBox spacing="10">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" text="Descrição / Sinopse" />
                        <Label fx:id="lblDescricao" style="-fx-text-fill: #475569; -fx-line-spacing: 5;" text="Descrição do livro aqui..." wrapText="true" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <VBox fx:id="actionContainer" spacing="12">
                        <HBox fx:id="alertaBloqueado" managed="false" spacing="10" style="-fx-background-color: #FEE2E2; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #EF4444;" visible="false">
                            <Label style="-fx-text-fill: #B91C1C;" text="⚠️ Regularize seus atrasos para solicitar." />
                        </HBox>
                        <HBox fx:id="alertaLimite" managed="false" spacing="10" style="-fx-background-color: #FEF3C7; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #F59E0B;" visible="false">
                            <Label style="-fx-text-fill: #92400E;" text="⚠️ Limite de empréstimos atingido." />
                        </HBox>
                        <HBox fx:id="alertaJaPossui" managed="false" spacing="10" style="-fx-background-color: #DBEAFE; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #3B82F6;" visible="false">
                            <Label style="-fx-text-fill: #1E40AF;" text="ℹ️ Você já possui este exemplar." />
                        </HBox>
                        <HBox fx:id="alertaJaReservado" managed="false" spacing="10" style="-fx-background-color: #FFEDD5; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #F97316;" visible="false">
                            <Label style="-fx-text-fill: #9A3412;" text="⏳ Você já está na fila de reserva." />
                        </HBox>

                        <Button fx:id="btnEmprestimo" managed="false" maxWidth="Infinity" onAction="#onEmprestimo" prefHeight="50" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" text="SOLICITAR EMPRÉSTIMO" visible="false" />

                        <Button fx:id="btnReserva" managed="false" maxWidth="Infinity" onAction="#onReserva" prefHeight="50" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" text="ENTRAR NA FILA DE ESPERA" visible="false" />
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <fx:include source="components/BottomMenu.fxml"/>
    </bottom>
</BorderPane>