<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@css/biblioqueue.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.controller.features.usuario.ReservasController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #1E3A8A; -fx-padding: 14 24 14 24;">
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 11px;" text="Bem Vindo" />
                <Label fx:id="lblNomeUsuario" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 16px;" text="Ana Silva" />
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="16">
                <ImageView fitHeight="250.0" fitWidth="300.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/logo.png" />
                    </image>
                </ImageView>
                <Button onAction="#onLogout" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                    <graphic>
                        <ImageView fx:id="irParaLogin" fitHeight="35.0" fitWidth="35.0" preserveRatio="true">
                            <image>
                                <Image url="@../../images/botaoSeta.jpeg" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #E8EEF7; -fx-background: #E8EEF7; -fx-border-color: transparent;">
            <VBox spacing="16" style="-fx-padding: 24 270 30 270; -fx-background-color: #E8EEF7;">

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" styleClass="section-title" text="Minhas Reservas" />
                        <Label style="-fx-text-fill: #64748B;" styleClass="section-subtitle" text="Acompanhe suas solicitações de reserva e sua posição na fila de espera." wrapText="true" />
                    </VBox>
                    <Label fx:id="lblContadorReservas" styleClass="counter-label" text="0/3" />
                </HBox>

                <VBox fx:id="emptyStateReservas" alignment="CENTER" managed="true" spacing="18" styleClass="empty-card" visible="true">

                    <VBox alignment="CENTER" style="-fx-background-color: #EFF6FF; -fx-background-radius: 50;                                  -fx-min-width: 70px; -fx-min-height: 70px;                                  -fx-max-width: 70px; -fx-max-height: 70px;">
                        <Label style="-fx-font-size: 28px;" text="🕐" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="6">
                        <Label styleClass="empty-title" text="Você não tem reservas ativas" />
                        <Label maxWidth="260" style="-fx-text-alignment: center;" styleClass="empty-subtitle" text="Entre na fila de espera quando um livro estiver indisponível" wrapText="true" />
                        <Label styleClass="empty-limit" text="Limite: 3 reservas simultâneas" />
                    </VBox>
                </VBox>

                <VBox fx:id="listaReservasContainer" managed="false" spacing="12" visible="false">
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0 transparent transparent transparent; -fx-border-width: 1 0 0 0; -fx-padding: 6 0 6 0;">
            <HBox alignment="CENTER" spacing="120" style="-fx-background-color: white; -fx-padding: 10 0 10 0; -fx-border-color: #E2E8F0 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                <children>
                    <VBox alignment="CENTER" onMouseClicked="#onNavCatalogo" prefWidth="426.0" spacing="5" style="-fx-cursor: hand;">
                        <children>
                            <ImageView fitHeight="51.0" fitWidth="470.0" preserveRatio="true">
                                <image>
                                    <Image url="@../../images/Catalogo.png" />
                                </image>
                            </ImageView>
                        </children>
                    </VBox>
                    <VBox alignment="CENTER" onMouseClicked="#onNavEmprestimos" prefWidth="426.0" spacing="5" style="-fx-cursor: hand;">
                        <children>
                            <ImageView fitHeight="63.0" fitWidth="71.0" preserveRatio="true">
                                <image>
                                    <Image url="@../../images/Emprestimo.png" />
                                </image>
                            </ImageView>
                        </children>
                    </VBox>
                    <VBox alignment="CENTER" onMouseClicked="#onNavReservas" prefWidth="426.0" spacing="5" style="-fx-cursor: hand;">
                        <children>
                            <ImageView fitHeight="58.0" fitWidth="59.0" preserveRatio="true">
                                <image>
                                    <Image url="@../../images/Reservas.png" />
                                </image>
                            </ImageView>
                        </children>
                    </VBox>
                </children>
            </HBox>

        </HBox>
    </bottom>

</BorderPane>