               <image>
                  <Image url="@../../../images/Catalogo.png" />
               </image>
            </ImageView>
         </children>
      </VBox>
      <VBox alignment="CENTER" onMouseClicked="#navegarParaEmprestimos" prefWidth="426.0" spacing="5" style="-fx-cursor: hand;">
