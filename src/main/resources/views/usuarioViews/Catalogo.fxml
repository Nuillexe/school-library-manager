<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@css/biblioqueue.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.controller.features.usuario.CatalogoController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #153A80; -fx-padding: 12 24 12 24;">
            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label style="-fx-text-fill: #D1D5DB; -fx-font-size: 11px;" text="Bem Vindo" />
                <Label fx:id="lblNomeUsuario" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="Nome aqui" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="20">
                <ImageView fitHeight="250.0" fitWidth="300.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/logo.png" />
                    </image>
                </ImageView>
                <Button onAction="#onLogout" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                    <graphic>
                        <ImageView fx:id="irParaLogin" fitHeight="35.0" fitWidth="35.0" preserveRatio="true">
                            <image>
                                <Image url="@../../images/botaoSeta.jpeg" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <bottom>
        <HBox alignment="CENTER" spacing="120" style="-fx-background-color: white; -fx-padding: 10 0 10 0; -fx-border-color: #E2E8F0 transparent transparent transparent; -fx-border-width: 1 0 0 0;">

            <VBox alignment="CENTER" onMouseClicked="#onNavCatalogo" prefWidth="426.0" spacing="5" style="-fx-cursor: hand;">
                <children>
                    <ImageView fitHeight="51.0" fitWidth="470.0" preserveRatio="true">
                        <image>
                            <Image url="@../../images/Catalogo.png" />
                        </image>
                    </ImageView>
                </children>
            </VBox>

            <VBox alignment="CENTER" onMouseClicked="#onNavEmprestimos" prefWidth="426.0" spacing="5" style="-fx-cursor: hand;">
                <ImageView fitHeight="63.0" fitWidth="71.0" preserveRatio="true">
                    <image>
                        <Image url="@../../images/Emprestimo.png" />
                    </image>
                </ImageView>
            </VBox>

            <VBox alignment="CENTER" onMouseClicked="#onNavReservas" prefWidth="426.0" spacing="5" style="-fx-cursor: hand;">
                <children>
                    <ImageView fitHeight="58.0" fitWidth="59.0" preserveRatio="true">
                        <image>
                            <Image url="@../../images/Reservas.png" />
                        </image>
                    </ImageView>
                </children>
            </VBox>

        </HBox>
    </bottom>

    <center>
        <VBox spacing="15" style="-fx-background-color: #E8EEF7; -fx-padding: 24 40 24 40;">

            <VBox spacing="4">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Catálogo de Livros" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Explore os livros disponíveis para empréstimo e reserva." />
            </VBox>

            <HBox alignment="CENTER_LEFT" style="-fx-padding: 5 0 5 0;">
                <HBox alignment="CENTER_LEFT" maxWidth="360" spacing="10" style="-fx-background-color: white; -fx-background-radius: 6; -fx-padding: 6 12 6 12; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" styleClass="filter-box">
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;" text="⚙" />
                    <ComboBox fx:id="comboCategorias" onAction="#onCategoriaChanged" prefWidth="280" promptText="Todas as categorias" style="-fx-background-color: transparent;" styleClass="filter-combo" />
                </HBox>
            </HBox>

            <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                <VBox fx:id="listaLivrosContainer" spacing="12" style="-fx-padding: 10 0 10 0; -fx-background-color: #E8EEF7;">
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>