<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifba.controller.features.bibliotecario.InventarioController">
    <top>
        <HBox alignment="CENTER_LEFT" maxHeight="80.0" minHeight="80.0" prefHeight="80.0" style="-fx-background-color: #1A3783;" BorderPane.alignment="CENTER">
            <padding><Insets left="40.0" right="40.0" /></padding>
            <children>
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 14px;" text="Bem Vindo" />
                        <Label fx:id="NomeUsuario" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px;" text="Nome aqui" />
                    </children>
                </VBox>
                <VBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <ImageView fitHeight="250.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../../images/logo.png" /></image>
                        </ImageView>
                    </children>
                </VBox>
                <ImageView fx:id="irParaLogin" fitHeight="35.0" fitWidth="35.0" onMouseClicked="#handleLogout" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../images/botaoSeta.jpeg" /></image>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                    <HBox.margin><Insets left="20.0" /></HBox.margin>
                </ImageView>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane>
            <ScrollPane fitToWidth="true" style="-fx-background-color: #E9EEF7; -fx-background: #E9EEF7;">
                <content>
                    <VBox spacing="20.0">
                        <padding><Insets bottom="120.0" left="40.0" right="40.0" top="30.0" /></padding>
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" text="Inventário de Títulos" />
                            <Label style="-fx-text-fill: #555555; -fx-font-size: 16px;" text="Visualize e gerencie todos os títulos da biblioteca." />
                        </VBox>

                        <FlowPane fx:id="containerLivros" alignment="TOP_LEFT" hgap="25.0" vgap="25.0" />
                    </VBox>
                </content>
            </ScrollPane>

            <StackPane alignment="BOTTOM_RIGHT" pickOnBounds="false">
                <StackPane maxHeight="75" maxWidth="75" onMouseClicked="#handleAdicionarLivro" style="-fx-cursor: hand;">
                    <StackPane.margin><Insets bottom="35.0" right="45.0" /></StackPane.margin>
                    <Circle fill="#1A3783" radius="35.0" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 4);" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 40px; -fx-font-weight: bold;" text="+" />
                </StackPane>
            </StackPane>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" prefHeight="85.0" style="-fx-background-color: white; -fx-border-color: #D1D1D1 transparent transparent transparent;">
         <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <children>
               <ImageView fitHeight="55.0" onMouseClicked="#dashboardController" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../images/botaoDashboard.jpeg" />
                  </image>
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </ImageView>
            </children>
         </VBox>
         <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <children>
               <ImageView fitHeight="55.0" onMouseClicked="#inventarioController" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../images/botaoInventario.jpeg" />
                  </image>
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </ImageView>
            </children>
         </VBox>
         <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <children>
               <ImageView fitHeight="55.0" onMouseClicked="#controleDeReservasController" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../images/botaoFilaDeReserva.jpeg" />
                  </image>
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </ImageView>
            </children>
         </VBox>
         <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <children>
               <ImageView fitHeight="55.0" onMouseClicked="#controleDeEmprestimosController" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../images/botaoDevolucoes.jpeg" />
                  </image>
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </ImageView>
            </children>
         </VBox>
        </HBox>
    </bottom>
</BorderPane>
